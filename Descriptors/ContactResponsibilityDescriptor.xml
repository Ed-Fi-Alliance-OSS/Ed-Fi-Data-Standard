<?xml version="1.0" encoding="UTF-8"?>
<InterchangeDescriptors xmlns="http://ed-fi.org/6.2.0" xmlns:ann="http://ed-fi.org/annotation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://ed-fi.org/6.2.0 ../Schemas/Bulk/Interchange-Descriptors.xsd">
	<ContactResponsibilityDescriptor>
		<CodeValue>Transportation</CodeValue>
		<ShortDescription>Transportation</ShortDescription>
		<Description>The contact is authorized to pick up the student from school or program activities.</Description>
		<Namespace>uri://ed-fi.org/ContactResponsibilityDescriptor</Namespace>
	</ContactResponsibilityDescriptor>
	<ContactResponsibilityDescriptor>
		<CodeValue>Mailing</CodeValue>
		<ShortDescription>Mailing</ShortDescription>
		<Description>The contact responsible for the purposes of sending and receiving correspondence, documents, or other items requiring a mailing address.</Description>
		<Namespace>uri://ed-fi.org/ContactResponsibilityDescriptor</Namespace>
	</ContactResponsibilityDescriptor>
	<ContactResponsibilityDescriptor>
		<CodeValue>Nurse-Related Contact</CodeValue>
		<ShortDescription>Nurse-Related Contact</ShortDescription>
		<Description>The contact is to be notified in the event of a medical emergency involving the student.</Description>
		<Namespace>uri://ed-fi.org/ContactResponsibilityDescriptor</Namespace>
	</ContactResponsibilityDescriptor>
	<ContactResponsibilityDescriptor>
		<CodeValue>Texting</CodeValue>
		<ShortDescription>Texting</ShortDescription>
		<Description>The contact responsible for the purposes of sending and receiving text messages related to the student.</Description>
		<Namespace>uri://ed-fi.org/ContactResponsibilityDescriptor</Namespace>
	</ContactResponsibilityDescriptor>
	<ContactResponsibilityDescriptor>
		<CodeValue>Attendance</CodeValue>
		<ShortDescription>Attendance</ShortDescription>
		<Description>The contact is to be invited to and participate in the student's attendance and related meetings.</Description>
		<Namespace>uri://ed-fi.org/ContactResponsibilityDescriptor</Namespace>
	</ContactResponsibilityDescriptor>
	<ContactResponsibilityDescriptor>
		<CodeValue>Bus-route responsibilities</CodeValue>
		<ShortDescription>Bus-route responsibilities</ShortDescription>
		<Description>The contact is responsible for Bus route information transporting the student to and from school or program services.</Description>
		<Namespace>uri://ed-fi.org/ContactResponsibilityDescriptor</Namespace>
	</ContactResponsibilityDescriptor>
	<ContactResponsibilityDescriptor>
		<CodeValue>Other program-specific responsibilities</CodeValue>
		<ShortDescription>Other program-specific responsibilities</ShortDescription>
		<Description>Other</Description>
		<Namespace>uri://ed-fi.org/ContactResponsibilityDescriptor</Namespace>
	</ContactResponsibilityDescriptor>
		<ContactResponsibilityDescriptor>
		<CodeValue>IDEA Parent</CodeValue>
		<ShortDescription>IDEA Parent</ShortDescription>
		<Description>The contact who acts as the parent under IDEA and is responsible for participating in decisions about the student's IEP, including consenting to evaluations, services, and placement.</Description>
		<Namespace>uri://ed-fi.org/ContactResponsibilityDescriptor</Namespace>
	</ContactResponsibilityDescriptor>
</InterchangeDescriptors>